# OpsHub environment — mirrors PROJECT.md §8.
# Copy to .env and fill in real values. Never commit .env.

# Core
DATABASE_URL=postgres://postgres:postgres@localhost:5432/opshub
NEXTAUTH_SECRET=replace-with-a-long-random-string
NEXTAUTH_URL=http://localhost:3000
# 32-byte base64 value, e.g. `openssl rand -base64 32`
ENCRYPTION_KEY=

# Ploi
PLOI_API_TOKEN=
PLOI_API_BASE=https://ploi.io/api
# Shared secret for the Ploi deploy-notification webhook (no HMAC); embed in
# the callback URL configured in the site's Notifications tab. See README.
PLOI_WEBHOOK_SECRET=

# Lighthouse webhook
LIGHTHOUSE_WEBHOOK_SECRET=

# Alert delivery
SLACK_WEBHOOK_URL=
RESEND_API_KEY=

# Worker
WORKER_POLL_INTERVAL_MS=10000

# Local development
USE_MOCKS=true
LOG_LEVEL=info
